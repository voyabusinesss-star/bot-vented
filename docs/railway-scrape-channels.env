# Coller dans Railway → Variables → Raw Editor (en plus de Whop/rôles)
# Mode direct sans proxy (IP Railway) + poll rapide — voir docs/SCRAPE_DEPLOYMENT.md
# SCRAPE_PROXY_URLS=
ENABLE_SCRAPE=1
SCRAPE_HEADLESS=true
VINTED_BASE_URL=https://www.vinted.fr
SCRAPE_FAST_MODE=1
REQUEST_DELAY_SECONDS=0.5
DISCORD_POST_DELAY_SECONDS=0.5
DISCORD_MIRROR_ALL_VETEMENT=true
SCRAPE_PARALLEL_WORKERS=1
SCRAPE_FILTER_WORKER_ENABLED=false
SCRAPE_POLL_SECONDS_MIN=0.3
SCRAPE_POLL_SECONDS_MAX=0.8
SCRAPE_BURST_ON_SECONDS=0
SCRAPE_BURST_OFF_SECONDS=0
# Auto-redeploy sur 403 persistants (token Project Railway — bot-scrape uniquement)
SCRAPE_AUTO_REDEPLOY_ENABLED=1
SCRAPE_403_REDEPLOY_THRESHOLD=8
SCRAPE_THREAD_REDEPLOY_THRESHOLD=3
SCRAPE_AUTO_REDEPLOY_COOLDOWN_SECONDS=900
SCRAPE_CHROMIUM_HEALTH_LOG_SECONDS=300
# RAILWAY_API_TOKEN=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
BOT_PREVIEW_INTERVAL_SECONDS=150
BOT_PREVIEW_VIA_OUTBOX=1
DISCORD_OUTBOX_MAX_MESSAGES=8
DISCORD_OUTBOX_FLUSH_POLL_SECONDS=0.6
SCRAPE_BLOCK_HEAVY_RESOURCES=true
ENABLE_DETECTOR=0
ENABLE_FICHES=0
# Proxy Webshare (optionnel) : STICKY FR — URL simple sans crochets JSON
# SCRAPE_PROXY_URLS=http://USER:PASS@p.webshare.io:80
MAX_RETRIES=3
