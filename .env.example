# Copy this file to .env and fill in real values:
#   cp .env.example .env

# App
APP_ENV=development
LOG_LEVEL=INFO

# Database (Phase 1)
DATABASE_URL=postgresql+psycopg://vinted:vinted@localhost:5432/vinted_bot

# Scraper (Phase 2+)
VINTED_BASE_URL=https://www.vinted.fr
# Délai entre requêtes Vinted (1s = rapide ; remonter si rate-limit)
# Anti-ban Vinted : ≥ 1.5s recommandé (le radar ajoute du jitter)
REQUEST_DELAY_SECONDS=1.8
MAX_RETRIES=3
SCRAPE_HEADLESS=true

# Discord (auto-post après scrape)
# Uniquement les marques avec canal + ID renseigné sont gardées / postées.
# DISCORD_CHANNEL_ALL = salon #all-vetement (regroupement)
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=

# Salon regroupement
DISCORD_CHANNEL_ALL=

# Marques — catégorie les-classiques (mettre l'ID numérique du salon)
DISCORD_CHANNEL_RALPH_LAUREN=
DISCORD_CHANNEL_NIKE=
DISCORD_CHANNEL_ADIDAS=
DISCORD_CHANNEL_CARHARTT=
DISCORD_CHANNEL_STONE_ISLAND=
DISCORD_CHANNEL_LACOSTE=
DISCORD_CHANNEL_TOMMY_HILFIGER=
DISCORD_CHANNEL_THE_NORTH_FACE=
DISCORD_CHANNEL_STUSSY=
DISCORD_CHANNEL_DICKIES=
DISCORD_CHANNEL_UNDER_ARMOUR=
DISCORD_CHANNEL_SUPREME=
DISCORD_CHANNEL_LEVIS=
DISCORD_CHANNEL_AMI_PARIS=
DISCORD_CHANNEL_THE_KOOPLES=
DISCORD_CHANNEL_COLUMBIA=

# Marques — catégorie LUXE REVENTE
DISCORD_CHANNEL_MONCLER=
DISCORD_CHANNEL_LOUIS_VUITTON=
DISCORD_CHANNEL_PRADA=
DISCORD_CHANNEL_CELINE=
DISCORD_CHANNEL_FENDI=
DISCORD_CHANNEL_BURBERRY=
DISCORD_CHANNEL_SAINT_LAURENT=
DISCORD_CHANNEL_HERMES=
DISCORD_CHANNEL_GIVENCHY=
DISCORD_CHANNEL_LOEWE=
DISCORD_CHANNEL_JACQUEMUS=
DISCORD_CHANNEL_ACNE_STUDIOS=
DISCORD_CHANNEL_TOTEME=
DISCORD_CHANNEL_GANNI=
DISCORD_CHANNEL_CDG=

# --- Pépites Sneakers (coller uniquement les IDs des salons Discord) ---
# Nike / Adidas sneakers = salons séparés des vêtements
DISCORD_CHANNEL_NIKE_SNEAKERS=
DISCORD_CHANNEL_ADIDAS_SNEAKERS=
DISCORD_CHANNEL_SALOMON=
DISCORD_CHANNEL_NEW_BALANCE=
DISCORD_CHANNEL_ASICS=
DISCORD_CHANNEL_HOKA=
DISCORD_CHANNEL_DR_MARTENS=
DISCORD_CHANNEL_ON_CLOUD=
DISCORD_CHANNEL_UGG=
DISCORD_CHANNEL_BIRKENSTOCK=
DISCORD_CHANNEL_SAUCONY=
DISCORD_CHANNEL_TIMBERLAND=
DISCORD_CHANNEL_JORDAN=
DISCORD_CHANNEL_YEEZY=

# Optionnel
DISCORD_GUILD_ID=
# Admins /set-plan (IDs Discord séparés par virgules)
DISCORD_FILTER_ADMIN_IDS=
# Salon annonces liaison Vinted (visible serveur). Sinon DISCORD_CHANNEL_LOGS.
DISCORD_CHANNEL_VINTED_LINKS=
# Salon #mes-alertes (panneau filtres privés)
#   uv run vinted-bot post-mes-alertes
DISCORD_CHANNEL_MES_ALERTES=
# Alertes DM filtres privés
PRIVATE_FILTER_DM_DELAY_SECONDS=60
PRIVATE_FILTER_MAX_AGE_SECONDS=900
PRIVATE_FILTER_MAX_DM_PER_SCRAPE=3
PRIVATE_FILTER_SCRAPE_INTERVAL_SECONDS=20
# --- Détecteur de niches / market-intel ---
# Pipeline permanent 24/7 (recommandé) :
#   uv run vinted-bot detector --loop
#   → collecte → analyse multi-angle → scores → Discord si opportunité / nouveau signal
# Analyse seule : uv run vinted-bot market-intel --once|--loop
# Mode mono-salon : renseigne uniquement NICHES (études de marché).
DISCORD_CHANNEL_NICHES=
# Demo / aperçu marketing (Wrangler…) — post-detector-apercu
DISCORD_CHANNEL_NICHES_DEMO=
# Webhook du salon demo (Paramètres salon → Intégrations → Webhooks → copier l'URL)
# Permet d'afficher le logo/nom du serveur à gauche (sans « Gérer les webhooks » sur le bot)
DISCORD_WEBHOOK_NICHES_DEMO=
# Niches vinted — intro + catalogue 1000 niches (post-niches-vinted-intro)
DISCORD_CHANNEL_NICHES_VINTED=
# Webhook du salon niches vinted (logo + nom serveur à gauche du message)
DISCORD_WEBHOOK_NICHES_VINTED=
# Fichier Excel joint au message intro (post-niches-vinted-intro)
NICHES_VINTED_CATALOG_PATH=config/Resello_1000_Niches_Vinted.xlsx
# Fiches produit live — 1/h, deep-dive ~1h (fiches-produit --loop)
DISCORD_CHANNEL_FICHES_PRODUIT=
# Durée deep-dive avant publication (secondes) — 3600 = 1 heure
FICHES_DEVELOP_SECONDS=3600
DISCORD_CHANNEL_MARQUES=
DISCORD_CHANNEL_MODELES=
# (Déprécié) Tendances → fusionné dans NICHES
DISCORD_CHANNEL_TENDANCES=
DISCORD_CHANNEL_TENDANCES_DU_JOUR=
DISCORD_CHANNEL_CLASSEMENTS=
# Pépites = salon séparé (sinon non postées)
DISCORD_CHANNEL_PEPITES=
DISCORD_CHANNEL_STATISTIQUES=
DISCORD_CHANNEL_LOGS=
# Portail liaison Vinted self-service (URL publique HTTPS, ex. ngrok → localhost:8787)
VINTED_LINK_PUBLIC_URL=
VINTED_LINK_SERVER_HOST=0.0.0.0
VINTED_LINK_SERVER_PORT=8787
# Pause entre annonces Discord (0 = envoi immédiat ; 0.2 recommandé vs 429)
DISCORD_POST_DELAY_SECONDS=0.2
