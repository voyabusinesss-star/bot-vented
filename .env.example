# Copy this file to .env and fill in real values:
#   cp .env.example .env

# App
APP_ENV=development
LOG_LEVEL=INFO

# Database (Phase 1)
DATABASE_URL=postgresql+psycopg://vinted:vinted@localhost:5432/vinted_bot

# Scraper (Phase 2+)
VINTED_BASE_URL=https://www.vinted.fr
REQUEST_DELAY_SECONDS=3
MAX_RETRIES=3
SCRAPE_HEADLESS=true

# Discord (auto-post après scrape)
# Uniquement les marques avec canal + ID renseigné sont gardées / postées.
# DISCORD_CHANNEL_ALL = salon #all-vetement (regroupement)
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=

# Salon regroupement
DISCORD_CHANNEL_ALL=

# Marques — catégorie les-classiques (mettre l'ID numérique du salon)
DISCORD_CHANNEL_RALPH_LAUREN=
DISCORD_CHANNEL_NIKE=
DISCORD_CHANNEL_ADIDAS=
DISCORD_CHANNEL_CARHARTT=
DISCORD_CHANNEL_STONE_ISLAND=
DISCORD_CHANNEL_LACOSTE=
DISCORD_CHANNEL_TOMMY_HILFIGER=
DISCORD_CHANNEL_THE_NORTH_FACE=
DISCORD_CHANNEL_STUSSY=
DISCORD_CHANNEL_DICKIES=
DISCORD_CHANNEL_UNDER_ARMOUR=
DISCORD_CHANNEL_SUPREME=
DISCORD_CHANNEL_LEVIS=
DISCORD_CHANNEL_AMI_PARIS=
DISCORD_CHANNEL_THE_KOOPLES=
DISCORD_CHANNEL_COLUMBIA=

# Marques — catégorie LUXE REVENTE
DISCORD_CHANNEL_MONCLER=
DISCORD_CHANNEL_LOUIS_VUITTON=
DISCORD_CHANNEL_PRADA=
DISCORD_CHANNEL_CELINE=
DISCORD_CHANNEL_FENDI=
DISCORD_CHANNEL_BURBERRY=
DISCORD_CHANNEL_SAINT_LAURENT=
DISCORD_CHANNEL_HERMES=
DISCORD_CHANNEL_GIVENCHY=
DISCORD_CHANNEL_LOEWE=
DISCORD_CHANNEL_JACQUEMUS=
DISCORD_CHANNEL_ACNE_STUDIOS=
DISCORD_CHANNEL_TOTEME=
DISCORD_CHANNEL_GANNI=
DISCORD_CHANNEL_CDG=

# Optionnel
DISCORD_CHANNEL_LOGS=
DISCORD_POST_DELAY_SECONDS=0.5
